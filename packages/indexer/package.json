{
  "name": "@freshcontext/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --exclude test/contract.test.ts",
    "test:contract": "vitest run test/contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freshcontext/graph": "workspace:*",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@freshcontext/hydra": "workspace:*"
  }
}
